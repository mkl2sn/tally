{
	"name": "tally",
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types && vite build",
		"preview": "wrangler dev --port 4173",
		"dev:full": "pnpm build && wrangler dev --port 8787",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen": "wrangler types",
		"lint": "oxlint && oxfmt --check .",
		"format": "oxfmt .",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:smoke": "node scripts/smoke.mjs",
		"test:watch": "vitest"
	},
	"dependencies": {
		"posthog-js": "^1.250.0",
		"posthog-node": "^4.16.0"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.18.2",
		"@fontsource-variable/outfit": "^5.2.8",
		"@iconify-json/lucide": "^1.2.116",
		"@playwright/test": "^1.61.1",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.1.1",
		"bits-ui": "^2.18.1",
		"oxfmt": "^0.58.0",
		"oxlint": "^1.73.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"unplugin-icons": "^23.0.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.10",
		"wrangler": "^4.97.0"
	},
	"packageManager": "pnpm@10.34.4"
}
