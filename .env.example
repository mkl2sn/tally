# PostHog configuration
# Projekt-Token aus den PostHog-Projekteinstellungen: https://eu.posthog.com/project/settings
PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# ID des Feedback-Surveys aus PostHog (Surveys). Leer lassen = Feedback-Button ausgeblendet.
PUBLIC_POSTHOG_FEEDBACK_SURVEY_ID=
