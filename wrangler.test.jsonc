// Test-only config for @cloudflare/vitest-pool-workers: a minimal worker that
// exposes the PokerRoom Durable Object without the SvelteKit build.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "tally-test",
	"compatibility_date": "2026-07-08",
	"main": "tests/do-worker.ts",
	"durable_objects": {
		"bindings": [
			{
				"name": "POKER_ROOM",
				"class_name": "PokerRoom"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["PokerRoom"]
		}
	]
}
